{
  "permissions": {
    "allow": [
      "Bash(xcodebuild:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git mv:*)",
      "Bash(wc:*)"
    ],
    "deny": [
      "Read(./KoreaSpots/Resources/Config/Secrets/**)",
      "Read(**/GoogleService-Info.plist)",
      "Bash(cat *Secrets*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.git/**)",
      "Read(./DerivedData/**)",
      "Read(./build/**)",
      "Read(./**/*.xcuserstate)",
      "Read(./**/xcuserdata/**)",
      "Read(./**/*.xcassets/**)",
      "Read(./**/*.dSYM)",
      "Read(./**/*.ipa)",
      "Read(./**/*.xcarchive)"
    ]
  }
}
